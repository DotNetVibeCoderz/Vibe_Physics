<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>ChronoBlazorApp</title>
    <link rel="stylesheet" href="_content/Chrono.Net.Blazor/chrono.css" />
    <style>
        html, body { margin: 0; height: 100%; background: #12161f; color: #dce3ee; font-family: system-ui, sans-serif; }
        main { display: grid; grid-template-rows: auto 1fr auto 160px; gap: 12px; height: 100vh; padding: 16px; box-sizing: border-box; }
        .view { border: 1px solid #2a3346; border-radius: 10px; overflow: hidden; min-height: 0; }
        button { background: #f2a33a; color: #1a1206; border: 0; border-radius: 6px; padding: 8px 16px; font-weight: 600; cursor: pointer; }
    </style>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
