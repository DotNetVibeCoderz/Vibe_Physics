<?xml version="1.0" encoding="utf-8"?>
<!--
  ChronoAppGen settings. Copied next to the app as ChronoAppGen.dll.config; the Settings dialog edits that copy.
  API keys stay empty in source control: enter them in Settings (they are written to the installed copy only).
  Per provider: Models (comma separated, first = default), ApiKey, Endpoint, Temperature (blank = provider default),
  MaxTokens, SystemPrompt (blank = Ai.SystemPrompt, blank again = Jack's built-in prompt).
-->
<configuration>
  <appSettings>
    <add key="Ai.ActiveProvider" value="DeepSeek" />
    <add key="Ai.ActiveModel" value="" />
    <add key="Ai.SystemPrompt" value="" />
    <add key="Ai.MaxToolRounds" value="40" />

    <add key="Provider.OpenAI.Models" value="gpt-5-mini,gpt-5" />
    <add key="Provider.OpenAI.ApiKey" value="" />
    <add key="Provider.OpenAI.Endpoint" value="https://api.openai.com/v1" />
    <add key="Provider.OpenAI.Temperature" value="" />
    <add key="Provider.OpenAI.MaxTokens" value="8192" />
    <add key="Provider.OpenAI.SystemPrompt" value="" />

    <add key="Provider.AzureOpenAI.Models" value="gpt-5-mini" />
    <add key="Provider.AzureOpenAI.ApiKey" value="" />
    <add key="Provider.AzureOpenAI.Endpoint" value="" />
    <add key="Provider.AzureOpenAI.Temperature" value="" />
    <add key="Provider.AzureOpenAI.MaxTokens" value="8192" />
    <add key="Provider.AzureOpenAI.SystemPrompt" value="" />

    <add key="Provider.Claude.Models" value="claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5" />
    <add key="Provider.Claude.ApiKey" value="" />
    <add key="Provider.Claude.Endpoint" value="https://api.anthropic.com" />
    <add key="Provider.Claude.WorkspaceId" value="" />
    <add key="Provider.Claude.Temperature" value="0.3" />
    <add key="Provider.Claude.MaxTokens" value="16000" />
    <add key="Provider.Claude.SystemPrompt" value="" />

    <add key="Provider.Gemini.Models" value="gemini-2.5-flash,gemini-2.5-pro" />
    <add key="Provider.Gemini.ApiKey" value="" />
    <add key="Provider.Gemini.Endpoint" value="https://generativelanguage.googleapis.com/v1beta/openai/" />
    <add key="Provider.Gemini.Temperature" value="0.3" />
    <add key="Provider.Gemini.MaxTokens" value="8192" />
    <add key="Provider.Gemini.SystemPrompt" value="" />

    <add key="Provider.Ollama.Models" value="qwen3-coder,llama3.2" />
    <add key="Provider.Ollama.ApiKey" value="" />
    <add key="Provider.Ollama.Endpoint" value="http://localhost:11434/v1" />
    <add key="Provider.Ollama.Temperature" value="0.3" />
    <add key="Provider.Ollama.MaxTokens" value="8192" />
    <add key="Provider.Ollama.SystemPrompt" value="" />

    <add key="Provider.DeepSeek.Models" value="deepseek-v4-flash,deepseek-v4-flash-vision-exp" />
    <add key="Provider.DeepSeek.ApiKey" value="" />
    <add key="Provider.DeepSeek.Endpoint" value="https://api.deepseek.com/v1" />
    <add key="Provider.DeepSeek.Temperature" value="0.3" />
    <add key="Provider.DeepSeek.MaxTokens" value="8192" />
    <add key="Provider.DeepSeek.SystemPrompt" value="" />

    <add key="Tavily.ApiKey" value="" />

    <add key="Editor.FontSize" value="14" />
    <add key="Editor.FontFamily" value="JetBrains Mono" />
    <add key="Editor.ShowLineNumbers" value="true" />
    <add key="Editor.WordWrap" value="false" />
    <add key="Editor.TabSize" value="4" />

    <add key="Layout.ExplorerVisible" value="true" />
    <add key="Layout.ExplorerWidth" value="260" />
    <add key="Layout.ChatVisible" value="true" />
    <add key="Layout.ChatWidth" value="420" />
    <add key="Layout.LogsVisible" value="true" />
    <add key="Layout.LogsHeight" value="190" />

    <add key="Projects.Root" value="" />
    <add key="Projects.Recent" value="" />
    <add key="Projects.ChronoNetVersion" value="0.1.0" />
    <add key="Projects.AvaloniaVersion" value="12.1.4" />
    <add key="Projects.LocalPackageFeed" value="" />

    <add key="Build.Configuration" value="Debug" />
    <add key="Deploy.Runtime" value="win-x64" />
    <add key="Deploy.SelfContained" value="false" />
    <add key="Deploy.SingleFile" value="false" />
  </appSettings>
</configuration>
