<!-- ChronoAppGen: the Chrono.Net instrument-bench look, extended for an IDE.
     Amber (Signal) marks what the user does; teal (Trace) marks what Jack does.
     Made by Gravicode Studios, led by Kang Fadhil. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="Rail">#0D1017</Color>
    <Color x:Key="Deck">#161B27</Color>
    <Color x:Key="Hover">#222A3A</Color>
    <Color x:Key="Fault">#F0656B</Color>
    <SolidColorBrush x:Key="RailBrush" Color="{StaticResource Rail}" />
    <SolidColorBrush x:Key="DeckBrush" Color="{StaticResource Deck}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource Hover}" />
    <SolidColorBrush x:Key="FaultBrush" Color="{StaticResource Fault}" />
    <SolidColorBrush x:Key="SignalSoftBrush" Color="#33F2A33A" />
    <SolidColorBrush x:Key="TraceSoftBrush" Color="#263CC8B4" />
  </Styles.Resources>

  <!-- ============ chrome: menu, toolbar, status bar ============ -->
  <Style Selector="Menu.chrome">
    <Setter Property="Background" Value="{StaticResource RailBrush}" />
    <Setter Property="Height" Value="30" />
  </Style>
  <Style Selector="Menu.chrome > MenuItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{StaticResource RailBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
  </Style>
  <Style Selector="Button.tool:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.tool.go">
    <Setter Property="Foreground" Value="{StaticResource SignalBrush}" />
  </Style>
  <Style Selector="Button.tool:disabled">
    <Setter Property="Opacity" Value="0.38" />
  </Style>
  <Style Selector="Button.mini:disabled">
    <Setter Property="Opacity" Value="0.38" />
  </Style>
  <Style Selector="Rectangle.sep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="Fill" Value="{StaticResource RuleBrush}" />
  </Style>

  <Style Selector="Border.status">
    <Setter Property="Background" Value="{StaticResource RailBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="TextBlock.stat">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,18,0" />
  </Style>

  <!-- ============ panels ============ -->
  <Style Selector="Border.deck">
    <Setter Property="Background" Value="{StaticResource DeckBrush}" />
  </Style>
  <Style Selector="TextBlock.panelTitle">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LetterSpacing" Value="1.8" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.mini">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.mini:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
  </Style>
  <Style Selector="Button.mini:pointerover">
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{StaticResource RuleBrush}" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{StaticResource SignalBrush}" />
  </Style>

  <!-- Explorer tree -->
  <Style Selector="TreeView.explorer TreeViewItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <!-- FileNode.IsExpanded survives explorer refreshes -->
    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
  </Style>
  <Style Selector="TreeView.explorer TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="#262E40" />
  </Style>
  <Style Selector="TreeView.explorer TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="#2C3549" />
  </Style>
  <Style Selector="TreeView.explorer TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="#262E40" />
  </Style>
  <Style Selector="TreeView.explorer TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>

  <!-- ============ editor tabs ============ -->
  <Style Selector="Border.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Padding" Value="12,0,6,0" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.tab:pointerover">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
  </Style>
  <Style Selector="Border.tab.active">
    <Setter Property="Background" Value="{StaticResource BenchBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" />
  </Style>

  <!-- ============ logs ============ -->
  <Style Selector="ToggleButton.logTab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.4" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ToggleButton.logTab:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="TextBox.log">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#B9C4D6" />
  </Style>
  <Style Selector="TextBox.log:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.log:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ============ chat ============ -->
  <Style Selector="Border.userMsg">
    <Setter Property="Background" Value="#242C3D" />
    <Setter Property="CornerRadius" Value="12,12,3,12" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="40,6,0,6" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="Border.jackMsg">
    <Setter Property="Padding" Value="0,6,4,10" />
  </Style>
  <Style Selector="Border.codeBlock">
    <Setter Property="Background" Value="#0E1219" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,6" />
  </Style>
  <Style Selector="Border.errorMsg">
    <Setter Property="Background" Value="#2A1A20" />
    <Setter Property="BorderBrush" Value="{StaticResource FaultBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,6" />
  </Style>
  <Style Selector="TextBox.composer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Padding" Value="2,6" />
  </Style>
  <Style Selector="TextBox.composer:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.composer:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.composerBox">
    <Setter Property="Background" Value="#1D2433" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,6,8,8" />
  </Style>
  <Style Selector="Border.composerBox:focus-within">
    <Setter Property="BorderBrush" Value="{StaticResource TraceBrush}" />
  </Style>
  <Style Selector="Button.send">
    <Setter Property="Background" Value="{StaticResource SignalBrush}" />
    <Setter Property="Foreground" Value="#1B1206" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.send:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#F5B562" />
    <Setter Property="Foreground" Value="#1B1206" />
  </Style>
  <Style Selector="Button.send.stop">
    <Setter Property="Background" Value="{StaticResource FaultBrush}" />
  </Style>
  <Style Selector="Button.send.stop:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#F48A8F" />
  </Style>
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="#1D2433" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="11,5" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource TraceBrush}" />
  </Style>

  <!-- ============ dialogs and cards ============ -->
  <Style Selector="ListBox.providers">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.providers ListBoxItem">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="ListBox.providers ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#262E40" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="ListBox.providers ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2C3549" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource DeckBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.card:pointerover">
    <Setter Property="BorderBrush" Value="#46526A" />
  </Style>
  <Style Selector="Border.card.selected">
    <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" />
    <Setter Property="Background" Value="#1F2230" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Margin" Value="0,10,0,4" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="28" />
  </Style>
</Styles>
